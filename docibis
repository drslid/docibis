#!/usr/bin/env bash
# docibis: day-to-day commands of a DocIbis installed by install.sh.
#
#   docibis status              containers, version, health, backups
#   docibis logs [-f] [api|web] logs of the containers
#   docibis backup              back up the database now
#   docibis backups             list the backups
#   docibis restore NAME        replace the database with a backup: its name,
#                               latest, or a day (2026-11-06)
#   docibis update [VERSION]    back up, install the latest release (or VERSION,
#                               or main), check it; back to the previous
#                               version and its data by itself on failure
#   docibis config [KEY=VALUE]  edit .env (or set values), then apply
#   docibis db move URL         move the database to PostgreSQL (postgres://…)
#
# DOCIBIS_DIR is the installation folder (/opt/docibis).
set -euo pipefail

DIR=${DOCIBIS_DIR:-/opt/docibis}
REPO=${DOCIBIS_REPO:-drslid/docibis}

bold=$(tput bold 2>/dev/null || true)
plain=$(tput sgr0 2>/dev/null || true)
say() { printf '%s==>%s %s\n' "$bold" "$plain" "$*"; }
die() { printf '%sxx%s  %s\n' "$bold" "$plain" "$*" >&2; exit 1; }

usage() {
  sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

[[ -d $DIR && -f $DIR/compose.yaml ]] || die "No DocIbis in $DIR (DOCIBIS_DIR)."
[[ -r $DIR/.env ]] || die "Run as root: sudo docibis $*"
cd "$DIR"

compose() { docker compose "$@"; }
running() { [[ -n $(compose ps -q --status running "$1" 2>/dev/null) ]]; }

# env_get KEY: the value written in .env, without its quotes.
env_get() { sed -n "s/^$1=//p" .env | tail -1 | sed "s/^'\(.*\)'$/\1/"; }

# env_set KEY VALUE: replaces or adds the line, .env kept private.
env_set() {
  local tmp
  tmp=$(mktemp "$DIR/.env.XXXXXX")
  awk -v key="$1" -v line="$1=$2" '
    index($0, key "=") == 1 { if (!done) print line; done = 1; next }
    { print }
    END { if (!done) print line }' .env >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" .env
}

# healthy: waits up to 3 minutes for the API to be ready.
healthy() {
  for _ in $(seq 90); do
    compose exec -T api docibis healthcheck ready >/dev/null 2>&1 && return 0
    sleep 2
  done
  return 1
}

# in_api ARGS: runs the docibis binary in the API container, or in a new one
# when the API is stopped.
in_api() {
  if running api; then
    compose exec -T api docibis "$@"
  else
    compose run --rm --no-deps api "$@"
  fi
}

# backup_name KIND: backs up and prints the name of the backup.
backup_name() {
  local out
  out=$(in_api backup --kind "$1") || { printf '%s\n' "$out" >&2; return 1; }
  printf '%s\n' "$out" >&2
  sed -n 's/^Backup made: \([^,]*\),.*/\1/p' <<<"$out"
}

cmd_status() {
  compose ps
  echo
  echo "Version:  $(env_get DOCIBIS_VERSION) (image), $(in_api version 2>/dev/null || echo '?') (running)"
  if running api && compose exec -T api docibis healthcheck ready >/dev/null 2>&1; then
    echo "Health:   ready"
  else
    echo "Health:   NOT READY (docibis logs api)"
  fi
  local db
  db=$(env_get DATABASE_URL)
  if [[ -n $db ]]; then
    echo "Database: PostgreSQL ${db##*@}"
  else
    echo "Database: SQLite in the data volume"
  fi
  echo "Disk:     $(df -h "$DIR" | awk 'NR == 2 {print $4 " free of " $2}')"
  echo
  in_api backups 2>/dev/null | sed -n '1,4p;$p' || echo "Backups:  not readable"
}

cmd_restore() {
  [[ $# -ge 1 ]] || usage
  local was=false ok=true
  running api && was=true
  if $was; then
    say "Stopping the API"
    compose stop api
  fi
  compose run --rm --no-deps api restore "$@" || ok=false
  if $was || $ok; then
    say "Starting the API"
    compose up -d api
    healthy || die "The API does not start: docibis logs api"
  fi
  $ok
}

cmd_update() {
  local target=${1:-} name previous api_id web_id
  if [[ -z $target ]]; then
    if [[ $(env_get DOCIBIS_VERSION) == edge ]]; then
      target=main
    else
      target=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null | grep -o '"tag_name": *"[^"]*"' | cut -d'"' -f4 || true)
    fi
  fi
  [[ -n $target ]] || die "No release found: docibis update main, or a release tag."
  running api || die "DocIbis is not running: docibis status"
  say "Backup before the update"
  name=$(backup_name update) || die "Backup failed: nothing changed."
  previous=$(env_get DOCIBIS_VERSION)
  api_id=$(docker inspect --format '{{.Image}}' "$(compose ps -q api)")
  web_id=$(docker inspect --format '{{.Image}}' "$(compose ps -q web)")
  rm -rf .previous && mkdir -p .previous
  cp -a compose.yaml .env apps .previous/

  say "Installing $target"
  local installer
  installer=$(mktemp)
  curl -fsSL "https://raw.githubusercontent.com/$REPO/$target/install.sh" -o "$installer" || die "No installer for $target: nothing changed."
  if DOCIBIS_YES=1 DOCIBIS_REF=$target DOCIBIS_DIR=$DIR DOCIBIS_REPO=$REPO bash "$installer" && healthy; then
    rm -f "$installer"
    say "Updated: $(in_api version)"
    return 0
  fi
  rm -f "$installer"

  say "The new version does not work: back to $previous"
  compose logs --tail 200 api >"$DIR/update-failed.log" 2>&1 || true
  compose stop api web || true
  rm -rf apps
  cp -a .previous/compose.yaml .previous/.env .previous/apps .
  # The images the previous compose.yaml names are the ones that ran.
  local image
  for image in $(compose config --images); do
    case $image in
      *docibis-api:*) docker tag "$api_id" "$image" ;;
      *docibis-web:*) docker tag "$web_id" "$image" ;;
    esac
  done
  # The new version may have changed the tables: back to the backup.
  compose run --rm --no-deps api restore "$name" --yes --force || die "Restore of $name failed: see docibis backups."
  compose up -d --pull never
  healthy || die "The previous version does not start either: docibis logs api"
  die "Update failed, $previous is back with the data of $name. Details: $DIR/update-failed.log"
}

cmd_config() {
  if [[ $# -eq 0 ]]; then
    cp -a .env .env.before
    ${EDITOR:-vi} .env
    chmod 600 .env
    cmp -s .env .env.before && { rm -f .env.before; echo "Nothing changed."; return 0; }
    rm -f .env.before
  else
    local pair
    for pair in "$@"; do
      [[ $pair =~ ^[A-Z][A-Z0-9_]*=.*$ ]] || die "Expected KEY=VALUE: $pair"
      env_set "${pair%%=*}" "${pair#*=}"
    done
  fi
  say "Applying"
  compose up -d
  healthy || die "The API does not start: docibis logs api"
}

cmd_db_move() {
  [[ ${1:-} == move && $# -eq 2 ]] || usage
  local url=$2 name
  [[ $url == postgres://* || $url == postgresql://* ]] || die "Expected a postgres://… address."
  [[ $url != *"'"* ]] || die "The address cannot contain a quote."
  running api || die "DocIbis is not running: docibis status"
  say "Backup of the current database"
  name=$(backup_name manual) || die "Backup failed: nothing changed."
  cp -a .env .env.before-move
  say "Stopping the API"
  compose stop api
  say "Copying into ${url##*@}"
  if ! compose run --rm --no-deps -e DATABASE_URL="$url" api restore "$name" --yes; then
    compose up -d api
    die "Copy failed: DocIbis goes on with its current database."
  fi
  env_set DATABASE_URL "'$url'"
  say "Starting on PostgreSQL"
  compose up -d api
  if ! healthy; then
    cp -a .env.before-move .env
    compose up -d api
    die "DocIbis does not start on PostgreSQL: back to the previous database. See docibis logs api."
  fi
  say "Moved. The previous settings are in $DIR/.env.before-move, the previous database stays in its volume."
}

[[ $# -ge 1 ]] || usage
command=$1
shift
case $command in
  status) cmd_status ;;
  logs) compose logs --tail 200 "$@" ;;
  backup) in_api backup "$@" ;;
  backups) in_api backups ;;
  restore) cmd_restore "$@" ;;
  update) cmd_update "$@" ;;
  config) cmd_config "$@" ;;
  db) cmd_db_move "$@" ;;
  version) in_api version ;;
  *) usage ;;
esac
